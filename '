#include <string.h>
#include <stdbool.h>

int minDeletionSize(char** strs, int strsSize) {
  int n = strsSize;
  int len = strlen(strs[0]);
  int res = 0;
  bool flag = 0;
  int i;

  // buf[][] = {known, unknown}
  int **buf = (int **) malloc(n*sizeof(int*));

  for (int i = 0; i < n; i++) {
    buf[i] = (int*) calloc(2, sizeof(int));
  }


  for (i = 0; i < len; i++) {
    for (j = 0; j < n-1; j++) {
      buf[j][0] = strs[j][i];
      if (strs[j+1][i] - strs[j][i] < 0) {
        break;
      }
    }
    buf[j][0] = strs[j][i];
  }

  for (int i = 0; i < n; i++) {
    free (buf[i]);
  }

  free (buf);

  return res;

}
